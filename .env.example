WMS_PORT=3101
WMS_USER=admin
WMS_PASS=
# Отображаемое имя системного админа (логин WMS_USER)
# WMS_ADMIN_NAME=Рубцов Сергей
# Публичный origin полного Учёта (админов с pick.* редиректим сюда)
WMS_PUBLIC_URL=https://uchetn1.ru
WMS_DATA_DIR=./data
WMS_INGEST_KEY=

# Google Drive · прайсы Жени (подпапки ↔ поставщики, опрос → Прайсы и корзины)
# Папку расшарить на SA: pnevmopodveska1-bank@pnevmopodveska1.iam.gserviceaccount.com (Читатель)
GDRIVE_PURCHASE_ROOT=14719E16hSlz2EXuiMdEjbsnFJfhI5sKs
# GOOGLE_SA_JSON=/root/bank_pnevmopodveska1_ru/public_html/pnevmopodveska1-677b14845bb0.json
# GDRIVE_PURCHASE_POLL_MS=180000
# GDRIVE_PURCHASE_POLL=1

# Публичные ссылки на оплату: https://pay.pnevmopodveska1.ru/pay/{token}
PAY_PUBLIC_URL=https://pay.pnevmopodveska1.ru
# Та же страница, что виджет Amo (?l=сделка) — fallback, если Учёт не создал /pay/{token}
PAY_PNEVMO_WIDGET_URL=https://pay.pnevmopodveska1.ru/?l={deal_id}
PAY_FOGEL_WIDGET_URL=https://pay.fogel.com.ru/?l={deal_id}

# TargetSMS — согласие ПДн по SMS
# Отправители в кабинете: Fogel (ИП М.П. / Фогель / Стрела), Pnevmo1 (ИП Р.П. / подвеска)
TARGETSMS_USER=
TARGETSMS_PASSWORD=
# Брендовые публичные URL (SMS-ссылки)
PDN_FOGEL_URL=https://pdn.fogel.com.ru
PDN_PNEVMO_URL=https://pdn.pnevmopodveska1.ru
# Запасной / старый домен (если brand не определён)
PDN_PUBLIC_URL=https://pdn.uchetn1.ru
# Т‑Банк рассрочка (Forma): {deal_id} / {lead_id} подставляются из заказа
# TBANK_INSTALLMENT_URL=https://rassrochka.pnevmopodveska1.ru/?l={deal_id}
# TBANK_FORMA_MARK_PAID_ON_SIGNED=1
# Webhook Forma → сайт → Учёт: POST /api/webhooks/tbank-forma?key=WMS_INGEST_KEY

# Swagger UI: https://swagger.uchetn1.ru → /api/swagger (+ /api/openapi.json)
# Enable on prod: SWAGGER_ENABLED=1. Access: admin session (login); optional Basic.
SWAGGER_ENABLED=0
# SWAGGER_BASIC_USER=swagger
# SWAGGER_BASIC_PASS=

# Web Push · фото авто при приёме (/reception-photo)
# Если пусто — ключи создаются сами в data/vapid.json при первом запуске
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@uchetn1.ru

ODATA_BASE_URL=
ODATA_USER=
ODATA_PASSWORD=

HS_BASE_URL=
HS_USER=
HS_PASS=

# Фото номенклатуры / чат / фото авто при приёме (оригиналы deal-car-photos/)
S3_ENDPOINT=
S3_REGION=default
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
S3_PATH_STYLE=false
# Опционально: квота бакета в ГБ (тогда на главной «S3 свободно»)
S3_QUOTA_GB=

AMO1C_STAFF_EXPORT=/root/amo1c_pnevmopodveska1_ru/public_html/bin/export_staff_for_wms.php
AMO1C_DEALS_EXPORT=/root/amo1c_pnevmopodveska1_ru/public_html/bin/export_deals_for_wms.php
AMO1C_COUNTERPARTIES_EXPORT=/root/amo1c_pnevmopodveska1_ru/public_html/bin/export_counterparties_for_wms.php
# Пуш Учёт → Amo (этап / CF / покупатель). По умолчанию ВЫКЛ.
# AMO_PUSH_TO_AMO=1
# AMO1C_DEAL_STAGE_PUSH=/root/amo1c_pnevmopodveska1_ru/public_html/bin/update_deal_stage_for_wms.php
# AMO1C_CONTACT_BUYER_PUSH=/root/amo1c_pnevmopodveska1_ru/public_html/bin/update_contact_buyer_for_wms.php
# AMO1C_DEAL_SALE_FIELDS_PUSH=/root/amo1c_pnevmopodveska1_ru/public_html/bin/update_deal_sale_fields_for_wms.php
# Публичный домен Учёта (ссылка в UI) + хост amo1c для OAuth redirect (секрет только в amo1c)
UCHET_PUBLIC_URL=https://uchetn1.ru
AMO1C_PUBLIC_URL=https://amo1c.pnevmopodveska1.ru
AMO_OAUTH_CLIENT_ID=
# Хук Amo (сделки/контакты/товары): переключатель в UI; ключ = WMS_INGEST_KEY
# AMO_WEBHOOK_KEY=
# AMO1C_WEBHOOK_MANAGE=/root/amo1c_pnevmopodveska1_ru/public_html/bin/manage_webhooks_for_wms.php
# AMO_OAUTH_SHARE_URL=https://www.amocrm.ru/oauth?client_id=…&mode=post_message
# AMO_OAUTH_REDIRECT_URI=https://amo1c.pnevmopodveska1.ru/amo/amo.php

# Точка СБП QR (через bank.pnevmopodveska1.ru)
# Предпочтительно задавать в UI: Настройки → Интеграции → Точка Банк (meta SQLite).
BANK_SBP_CREATE_URL=https://bank.pnevmopodveska1.ru/api/sbp_create_qr.php
BANK_SBP_STATUS_URL=https://bank.pnevmopodveska1.ru/api/sbp_qr_status.php
BANK_SBP_KEY=
# BANK_TOCHKA_OVERVIEW_URL=https://bank.pnevmopodveska1.ru/api/tochka_overview.php

# СДЭК native (OAuth client_id/secret только на widget; мост — UI Интеграции → СДЭК)
CDEK_WIDGET_URL=https://widget.pnevmopodveska1.ru/cdek/deal.php?l={lead_id}
CDEK_WMS_URL=https://widget.pnevmopodveska1.ru/cdek/wms_api.php
# Если пусто — берётся BANK_SBP_KEY (тот же X-Wms-Key, что на виджете в wms_api_key.txt)
CDEK_WMS_KEY=

# Admin 2FA через Telegram (вместо SMS). Max — не в стеке ботов (нет Bot API).
# Режим: auto (вкл. если токен+chat) | 1 (обязательно) | 0 / off (выкл., пароль-only).
# Сейчас по запросу клиента: off — без кодов входа в Telegram.
WMS_ADMIN_2FA=off
# Токен @RubtsovHelpBot для Учёта (задания СТО, алерты, опц. 2FA). Не путать с @finpnevmo_bot (оплаты bank).
TELEGRAM_BOT_TOKEN=
# Личный chat_id админа (бот /start). Нужен только при WMS_ADMIN_2FA=auto|on.
TELEGRAM_2FA_CHAT_ID=
# Cloudflare worker gateway (как bank) — прямой api.telegram.org с VPS РФ таймаутит
TELEGRAM_WORKER_URL=
TELEGRAM_WORKER_SECRET=
# Дубль «Задание на СТО» складу через бота (общий chat и/или staff.telegram_chat_id у warehouse/admin)
# TELEGRAM_WAREHOUSE_CHAT_ID=
# Опционально: staff.telegram_chat_id в БД для персонального 2FA сотрудников-admin

# АТОЛ Онлайн — предпочтительно UI: Настройки → Интеграции → АТОЛ (meta SQLite).
# Env — fallback, если в UI ещё не сохраняли.
ATOL_API_URL=https://online.atol.ru/possystem/v5
ATOL_LOGIN=
ATOL_PASS=
ATOL_GROUP_CODE=
# ИП Безматерных Р.П. (касса на это юрлицо)
ATOL_INN=231215603728
ATOL_SNO=usn_income
ATOL_COMPANY_EMAIL=
ATOL_PAYMENT_ADDRESS=https://pay.pnevmopodveska1.ru
ATOL_CLIENT_EMAIL=

# Яндекс Пэй / Сплит (организация: https://id.yandex.ru/org · кабинет: https://pay.yandex.ru/)
# В sandbox API-ключ = Merchant ID. В production — ключ из Настройки → Merchant API.
YANDEX_PAY_ENABLED=0
YANDEX_PAY_ENV=sandbox
YANDEX_PAY_MERCHANT_ID=
YANDEX_PAY_API_KEY=
YANDEX_PAY_ORG_NAME=
YANDEX_PAY_ORG_ID=
# Юрлицо в Учёте №1 (organizations.id) — для кого этот merchant
YANDEX_PAY_ORGANIZATION_ID=
YANDEX_PAY_METHODS=SPLIT

# DaData — предпочтительно UI: Настройки → Интеграции → DaData.
# Ключи из https://dadata.ru/profile/#info (не логин/пароль сайта).
DADATA_API_KEY=
DADATA_SECRET=

# Контур.Экстерн — автоподача налоговой отчётности (см. docs/TAX-payroll-kontur.md)
# Заявка: https://kontur.ru/extern/api/razrabotchikam-po
KONTUR_EXTERN_API_KEY=
KONTUR_EXTERN_CLIENT_ID=
KONTUR_EXTERN_ACCOUNT_ID=
KONTUR_EXTERN_BASE_URL=https://extern-api.testkontur.ru
KONTUR_EXTERN_AUTH_URL=https://identity.testkontur.ru/connect/token
KONTUR_EXTERN_SCOPE=extern.api
KONTUR_EXTERN_TEST=1
# KONTUR_EXTERN_SIGNATURE_B64=

# DeepSeek — запасной cloud OCR (только если OCR_MODE=cloud). Предпочтительно UI: Настройки → OCR документов.
# Официальный api.deepseek.com — text-only; для фото укажите шлюз с VL (OpenRouter и т.п.).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-chat
# Локальный OCR СТС (on-prem). По умолчанию фото не уходят наружу.
OCR_MODE=local
OCR_LOCAL_URL=http://127.0.0.1:3105
# Cloudflare Workers AI мост (если OpenRouter режет IP VPS). Worker: deploy/cloudflare/openrouter-bridge
# CF_STS_OCR_URL=https://openrouter-bridge-uchet1.<account>.workers.dev
# OPENROUTER_BRIDGE_SECRET= # тот же, что wrangler secret BRIDGE_SECRET
